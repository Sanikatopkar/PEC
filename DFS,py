#DFS
graph={
    'A':['B','C','D'],
    'B':[],
    'C':['E','F'],
    'D':['H'],
    'E':[],
    'F':['I','G'],
    'G':[],
    'H':[],
    'I':[]
    
}
start='A'
goal='G'
stack=[start]
visited=[]

while stack:
    node=stack.pop()
    if node not in visited:
        print(node,end=" ")
        visited.append(node)
        if node ==goal:
            print("\nGoal Reached!")
            break
        for child in graph[node]:
            if child not in visited:
                stack.append(child)
